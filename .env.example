POSTGRES_USER=greener_user
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=greener_db
POSTGRES_HOST=greener-postgres
POSTGRES_PORT=5432
JWT_SECRET=seu_segredo_jwt_aqui
JWT_EXPIRATION=1d

# Backend: Metrics Aggregator and periodic collector
AGGREGATOR_API_URL=https://metrics.unilaunch.org
AGGREGATOR_SERVICES_PATH=/services
AGGREGATOR_TIMEOUT=5000
METRICS_COLLECTION_INTERVAL_SECONDS=30

# Carbon Intensity API
CARBON_INTENSITY_API_URL=https://carbon.unilaunch.org
CARBON_INTENSITY_TIMEOUT_MS=5000
# Obrigatória: informe o fator de fallback aprovado para o ambiente (gCO2e/kWh).
CARBON_INTENSITY_FALLBACK_G_PER_KWH=

# Frontend: endereco do backend, acessado pelo NAVEGADOR (use localhost, nao o nome do container)
VITE_API_URL=http://localhost:3001/api
FRONTEND_ORIGIN=http://localhost:3000